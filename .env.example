# 360YA Explorer Community v1.0.1 — Configuración de ejemplo sin secretos
# Copiar este archivo a .env y ajustar según sea necesario

# Host y puerto de escucha (127.0.0.1 para acceso local seguro / túnel SSH)
EXPLORER_HOST=127.0.0.1
EXPLORER_PORT=8766

# Contraseña maestra de acceso (mínimo 12 caracteres obligatorios)
EXPLORER_PASSWORD=GENERAR_EN_INSTALACION

# Rutas de almacenamiento de datos y base de datos de auditoría
EXPLORER_DATA_DIR=data
EXPLORER_STATE_DIR=data/.state

# Ruta al archivo known_hosts de SSH para validar huellas de servidores remotos
EXPLORER_KNOWN_HOSTS=~/.ssh/known_hosts

# Habilitar flag Secure en cookies de sesión (activar si se expone tras proxy HTTPS)
EXPLORER_HTTPS=0
